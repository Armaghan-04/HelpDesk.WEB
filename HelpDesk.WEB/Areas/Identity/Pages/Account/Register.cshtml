@page
@model RegisterModel
@{
    ViewData["Title"] = "Create account";
}

<div class="row g-4 align-items-stretch hd-auth">
    <div class="col-lg-5 d-none d-lg-flex">
        <aside class="hd-auth-aside">
            <div>
                <span class="hd-eyebrow" style="color: rgba(244,243,238,.7);">Join the desk</span>
                <h1 class="hd-auth-title">Less chasing.<br />More fixing.</h1>
                <p class="hd-auth-text">
                    Create an account to raise requests, follow progress, and keep every
                    answer in a single, tidy thread.
                </p>
            </div>
            <ul class="hd-auth-list">
                <li>Structured requests, not lost emails</li>
                <li>Live status on every ticket</li>
                <li>One shared conversation history</li>
            </ul>
        </aside>
    </div>

    <div class="col-lg-7">
        <section class="hd-card hd-auth-card">
            <span class="hd-eyebrow">Account</span>
            <h2 class="hd-display" style="font-size: clamp(1.8rem, 3vw, 2.35rem);">Create your account</h2>
            <p class="hd-lead mb-4">It takes less than a minute. You can add more details later.</p>

            <form id="registerForm" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

                <div class="mb-3">
                    <label class="form-label" asp-for="Input.FullName">Full name</label>
                    <input class="form-control" asp-for="Input.FullName" autocomplete="name"
                           maxlength="@DomainConstraints.User.FullNameMaxLength" placeholder="e.g. Alex Morgan" />
                    <span class="field-validation-error" asp-validation-for="Input.FullName"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label" asp-for="Input.Email">Email</label>
                    <input class="form-control" asp-for="Input.Email" type="email" autocomplete="username"
                           maxlength="256" placeholder="you@company.com" />
                    <span class="field-validation-error" asp-validation-for="Input.Email"></span>
                </div>

                <p class="form-text mb-3">
                    New accounts start with <strong>Employee</strong> access. A manager can promote you
                    to Technician or Manager from the Team page.
                </p>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" asp-for="Input.Password">Password</label>
                        <div class="hd-password-field">
                            <input class="form-control" asp-for="Input.Password" type="password"
                                   autocomplete="new-password" placeholder="At least 6 characters" />
                            <button type="button" class="hd-password-toggle" data-password-toggle="Input_Password"
                                    aria-label="Show password" aria-pressed="false" title="Show password">
                                <svg class="hd-eye hd-eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12Z" />
                                    <circle cx="12" cy="12" r="2.75" />
                                </svg>
                                <svg class="hd-eye hd-eye-hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12Z" />
                                    <circle cx="12" cy="12" r="2.75" />
                                    <path d="M3 3l18 18" />
                                </svg>
                            </button>
                        </div>
                        <span class="field-validation-error" asp-validation-for="Input.Password"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" asp-for="Input.ConfirmPassword">Confirm password</label>
                        <div class="hd-password-field">
                            <input class="form-control" asp-for="Input.ConfirmPassword" type="password"
                                   autocomplete="new-password" placeholder="Repeat your password" />
                            <button type="button" class="hd-password-toggle" data-password-toggle="Input_ConfirmPassword"
                                    aria-label="Show confirmation password" aria-pressed="false" title="Show confirmation password">
                                <svg class="hd-eye hd-eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12Z" />
                                    <circle cx="12" cy="12" r="2.75" />
                                </svg>
                                <svg class="hd-eye hd-eye-hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12Z" />
                                    <circle cx="12" cy="12" r="2.75" />
                                    <path d="M3 3l18 18" />
                                </svg>
                            </button>
                        </div>
                        <span class="field-validation-error" asp-validation-for="Input.ConfirmPassword"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-hd-primary w-100 mt-4">Create account</button>
            </form>

            <p class="small text-muted mt-3 mb-0">
                Already have an account?
                <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Sign in</a>
            </p>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
