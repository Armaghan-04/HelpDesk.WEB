@page
@model LoginModel
@inject IOptions<AuthenticationSettings> AuthenticationOptions
@{
    ViewData["Title"] = "Sign in";
    ViewData["BodyClass"] = "hd-login-page";
    var registrationEnabled = AuthenticationOptions.Value.Registration.Enabled;
    var passwordRecoveryEnabled = AuthenticationOptions.Value.PasswordRecovery.Enabled;
}

<div class="hd-login">
    <aside class="hd-login-showcase" aria-labelledby="hd-demo-title">
        <div class="hd-login-showcase-inner">
            <div class="hd-demo hd-demo-dark">
                <header class="hd-demo-intro">
                    <span class="hd-login-kicker hd-login-kicker-light">Demo accounts</span>
                    <h1 id="hd-demo-title">Try every side of the desk.</h1>
                    <p>Pick a role to fill the sign-in form instantly — no setup, no waiting.</p>
                </header>
                <partial name="_DemoAccounts" model="Model.DemoAccounts" />
            </div>
        </div>
    </aside>

    <section class="hd-login-form-panel" aria-labelledby="hd-login-title">
        <div class="hd-login-form-card">
            <div class="hd-login-form-head">
                <span class="hd-login-kicker">Account access</span>
                <h2 id="hd-login-title">Welcome back</h2>
                <p>Sign in to pick up where your team left off.</p>
            </div>

            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="hd-form-alert" role="alert"></div>
                <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

                <div class="hd-login-field">
                    <label class="form-label" asp-for="Input.Email">Email address</label>
                    <input class="form-control" asp-for="Input.Email" type="email"
                           autocomplete="username" autofocus placeholder="you@company.com" />
                    <span class="field-validation-error" asp-validation-for="Input.Email"></span>
                </div>

                <div class="hd-login-field">
                    <div class="hd-login-label-row">
                        <label class="form-label" asp-for="Input.Password">Password</label>
                        @if (passwordRecoveryEnabled)
                        {
                            <a class="hd-login-forgot" asp-page="./ForgotPassword">Forgot password?</a>
                        }
                    </div>
                    <div class="hd-password-field">
                        <input class="form-control" asp-for="Input.Password" type="password"
                               autocomplete="current-password" placeholder="Your password" />
                        <button type="button" class="hd-password-toggle" data-password-toggle="Input_Password"
                                aria-label="Show password" aria-pressed="false" title="Show password">
                            <svg class="hd-eye hd-eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12Z" />
                                <circle cx="12" cy="12" r="2.75" />
                            </svg>
                            <svg class="hd-eye hd-eye-hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12Z" />
                                <circle cx="12" cy="12" r="2.75" />
                                <path d="M3 3l18 18" />
                            </svg>
                        </button>
                    </div>
                    <span class="field-validation-error" asp-validation-for="Input.Password"></span>
                </div>

                <div class="form-check hd-login-remember">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label class="form-check-label" asp-for="Input.RememberMe"></label>
                </div>

                <button id="login-submit" type="submit" class="btn btn-hd-primary w-100 hd-login-submit">
                    Sign in
                    <svg class="hd-icon" aria-hidden="true" focusable="false"><use href="#i-arrow"></use></svg>
                </button>

                <p id="demo-fill-status" class="visually-hidden" aria-live="polite"></p>

                @if (registrationEnabled)
                {
                    <p class="hd-login-create">
                        New to HelpDesk?
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a>
                    </p>
                }
            </form>
        </div>

        <details class="hd-login-demo-mobile d-lg-none">
            <summary>
                <span>Demo accounts</span>
                <span class="hd-login-demo-count">@Model.DemoAccounts.Count roles</span>
            </summary>
            <div class="hd-demo hd-demo-light">
                <partial name="_DemoAccounts" model="Model.DemoAccounts" />
            </div>
        </details>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
