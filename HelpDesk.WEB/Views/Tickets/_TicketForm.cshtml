@model TicketFormViewModel
@{
    var action = Model.IsEdit ? "Edit" : "Create";
    ViewData["SubmitDisabled"] = Model.Departments.Count == 0;
}

<form method="post" asp-action="@action" asp-route-id="@(Model.IsEdit ? Model.Id : null)" class="hd-card">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

    <div class="mb-3">
        <label class="form-label" asp-for="Title">Title</label>
        <input class="form-control" asp-for="Title" maxlength="@DomainConstraints.Ticket.TitleMaxLength"
               placeholder="A short, clear summary of the issue" autocomplete="off" />
        <span class="field-validation-error" asp-validation-for="Title"></span>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label" asp-for="DepartmentId">Department</label>
            <select class="form-select" asp-for="DepartmentId">
                <option value="">Choose a department...</option>
                @foreach (var department in Model.Departments)
                {
                    <option value="@department.Id" selected="@(Model.DepartmentId == department.Id ? "selected" : null)">
                        @department.Name
                    </option>
                }
            </select>
            <span class="field-validation-error" asp-validation-for="DepartmentId"></span>
            @if (Model.Departments.Count == 0)
            {
                <div class="form-text">No active departments are configured yet.</div>
            }
        </div>

        <div class="col-md-6">
            <label class="form-label" asp-for="Priority">Priority</label>
            <select class="form-select" asp-for="Priority">
                @foreach (var priority in Enum.GetValues<TicketPriority>())
                {
                    <option value="@priority" selected="@(Model.Priority == priority ? "selected" : null)">@priority</option>
                }
            </select>
            <div class="form-text">Critical means work is fully blocked.</div>
        </div>
    </div>

    <div class="mt-3">
        <label class="form-label" asp-for="Description">Description</label>
        <textarea class="form-control" asp-for="Description" rows="7"
                  hd-counted="@DomainConstraints.Ticket.DescriptionMaxLength"
                  placeholder="What happened? Include steps to reproduce, error messages, and anything you already tried."></textarea>
    </div>

    @if (Model.Departments.Count == 0)
    {
        <div class="alert alert-warning mt-3 mb-0 small" role="alert">
            Tickets need a department. Ask a manager to add an active department before creating one.
        </div>
    }

    <partial name="_FormActions" />
</form>
