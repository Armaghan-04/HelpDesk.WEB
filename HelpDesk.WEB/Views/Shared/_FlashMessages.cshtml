@{
    var success = TempData["Success"] as string;
    var error = TempData["Error"] as string;
}

@if (!string.IsNullOrWhiteSpace(success) || !string.IsNullOrWhiteSpace(error))
{
    <div class="toast-container position-fixed top-0 end-0 p-3 hd-toast-stack">
        @if (!string.IsNullOrWhiteSpace(success))
        {
            <div class="toast hd-toast is-success" role="status" aria-live="polite" aria-atomic="true" data-bs-delay="5000">
                <div class="d-flex">
                    <div class="toast-body">
                        <span class="hd-toast-label">Done</span>
                        @success
                    </div>
                    <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="toast hd-toast is-error" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="8000">
                <div class="d-flex">
                    <div class="toast-body">
                        <span class="hd-toast-label">Heads up</span>
                        @error
                    </div>
                    <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }
    </div>
}
